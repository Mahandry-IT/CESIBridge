# Copier en .env. Format compatible avec `docker run --env-file` : pas de guillemets, pas de commentaire en fin de ligne.

# Page d'accueil de l'ENT CESI (point d'entrée de la chaîne SSO).
CESI_ENT_URL=https://ent.cesi.fr/

# Hôtes qui signifient « connecté », séparés par des virgules (voir `npm run explore`).
# `*.domaine.fr` accepte tous les sous-domaines.
CESI_LOGGED_IN_HOSTS=ent.cesi.fr

# Chemin du storageState. Défaut : ./data/state.json en local, /data/state.json dans l'image Docker.
# CESI_STATE_PATH=./data/state.json

# Timeouts (ms) : navigation ENT et login manuel (MFA compris).
# CESI_NAV_TIMEOUT_MS=30000
# CESI_LOGIN_TIMEOUT_MS=300000
