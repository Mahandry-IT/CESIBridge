# Copier en .env. Format compatible avec `docker run --env-file` : pas de guillemets, pas de commentaire en fin de ligne.

# Page d'accueil de l'ENT CESI (point d'entrée de la chaîne SSO).
CESI_ENT_URL=https://ent.cesi.fr/

# Hôtes qui signifient « connecté », séparés par des virgules (voir `npm run explore`).
# `*.domaine.fr` accepte tous les sous-domaines.
CESI_LOGGED_IN_HOSTS=ent.cesi.fr,moodle.cesi.fr

# Chemin du storageState. Défaut : ./data/state.json en local, /data/state.json dans l'image Docker.
# CESI_STATE_PATH=./data/state.json

# Timeouts (ms) : navigation ENT et login manuel (MFA compris).
# CESI_NAV_TIMEOUT_MS=30000
# CESI_LOGIN_TIMEOUT_MS=300000

# --- Moodle et Scholarvox (serveur MCP) ---

# Lien d'accès Moodle (SSO). Facultatif : sinon lu dans le lien « Moodle One Cesi » de l'ENT.
# CESI_MOODLE_URL=https://moodle.cesi.fr/login/index.php?authCAS=CAS
# Dossier des fichiers téléchargés par moodle_download_resource (/data/downloads dans l'image Docker).
# CESI_DOWNLOAD_DIR=./data/downloads
# Taille maximale d'un fichier téléchargé, en Mo (1 à 500).
# CESI_DOWNLOAD_MAX_MB=50

# --- Synchronisation de l'emploi du temps (npm run sync) ---

# Identifiants du login automatique. Ne jamais les committer ni les journaliser.
# Obligatoires pour npm run sync. Facultatifs pour le serveur MCP (mais ensemble) :
# ils lui permettent de se reconnecter seul quand la session expire.
CESI_EMAIL=prenom.nom@viacesi.fr
CESI_PASSWORD=
# Identifiant numérique de la personne (paramètre codePersonne de l'API des séances).
# Facultatif : découvert automatiquement sur la page emploi du temps après le login.
# CESI_CODE_PERSONNE=
# Nombre de semaines à synchroniser, de 1 à 8 (semaine courante comprise).
# CESI_SCHEDULE_WEEKS=4
# Navigateur masqué si true. Défaut false (fenêtre visible). Forcé à true dans le service Docker `sync`.
# CESI_HEADLESS=false

# Base PostgreSQL (docker compose up -d db). Utilisée par `npm run sync` depuis l'hôte.
DATABASE_URL=postgres://cesi:changeMe@localhost:5433/cesibridge
# Conteneur `db` : doivent correspondre à DATABASE_URL. Changer le mot de passe par défaut.
POSTGRES_USER=cesi
POSTGRES_PASSWORD=changeMe
POSTGRES_DB=cesibridge
# Port publié sur l'hôte (5432 souvent pris par un PostgreSQL local). Doit correspondre à DATABASE_URL.
# POSTGRES_HOST_PORT=5433

# --- Google Calendar (npm run sync / npm run publish) ---

# Facultatif, mais les deux variables vont ensemble. Voir README, section « Google Calendar ».
# ID de l'agenda (Paramètres de l'agenda > Intégrer l'agenda).
# GOOGLE_CALENDAR_ID=
# Clé JSON du compte de service. Dans Docker, le service `sync` la lit dans ./secrets/google-sa.json.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-sa.json

# --- Calendrier des examens (npm run sync / npm run publish) ---

# Facultatif : publie le calendrier des examens (lu par OCR sur Moodle) dans Google Calendar.
# Filière et niveau vont ensemble ; sans eux, la fonctionnalité est désactivée.
# CESI_FILIERE=FISE Informatique
# CESI_NIVEAU=A3
# Année scolaire AAAA-AAAA. Défaut : l'année en cours (change le 1er août).
# CESI_ANNEE=2026-2027
# Rappels, en jours avant l'examen : 4 valeurs maximum, de 1 à 27, séparées par des virgules.
# CESI_EXAM_REMINDER_DAYS=1
# Fichier JSON de corrections manuelles de la lecture OCR.
# CESI_EXAM_CORRECTIONS_FILE=./data/exam-corrections.json
