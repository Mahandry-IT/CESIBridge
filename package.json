{
  "name": "cesibridge",
  "version": "0.1.0",
  "description": "Serveur MCP (stdio) qui vérifie la session SSO CESI via Playwright",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "explore": "node --env-file-if-exists=.env scripts/explore.js",
    "login": "node --env-file-if-exists=.env scripts/login.js",
    "sync": "node --env-file-if-exists=.env scripts/sync.js",
    "publish": "node --env-file-if-exists=.env scripts/publish.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "mcp:browsers": "node node_modules/@playwright/mcp/node_modules/playwright-core/cli.js install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "google-auth-library": "^11.2.0",
    "pg": "^8.23.1",
    "playwright": "1.64.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "0.0.82",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  }
}
